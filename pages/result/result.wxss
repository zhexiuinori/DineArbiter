.page-container {
  min-height: 100vh;
  background: var(--color-surface-dark);
  padding: var(--space-3);
}

.thinking-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 80vh;
}

.thinking-animation {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: var(--space-5);
}

.scale-wrap {
  animation: scaleBalance 1.5s var(--ease-out-quart) infinite;
}

.scale-emoji {
  font-size: 120rpx;
}

@keyframes scaleBalance {
  0%, 100% { transform: rotate(-10deg); }
  50% { transform: rotate(10deg); }
}

.thinking-dots {
  display: flex;
  gap: var(--space-2);
  margin-top: 30rpx;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--color-brand);
  animation: dotPulse 1.4s var(--ease-out-quart) infinite;
}

.dot-1 { animation-delay: 0s; }
.dot-2 { animation-delay: 0.2s; }
.dot-3 { animation-delay: 0.4s; }

@keyframes dotPulse {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
  40% { transform: scale(1.2); opacity: 1; }
}

.thinking-text {
  font-size: var(--text-lg);
  color: var(--color-brand);
  font-weight: bold;
  margin-bottom: 30rpx;
  animation: textPulse 2s var(--ease-out-quart) infinite;
}

@keyframes textPulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.6; }
}

.thinking-progress {
  width: 400rpx;
  height: 4rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 2rpx;
  overflow: hidden;
}

.thinking-bar {
  height: 100%;
  background: var(--color-brand);
  border-radius: 2rpx;
  transition: width var(--duration-normal) var(--ease-out-quart);
}

.result-section {
  padding-top: 10rpx;
}

.verdict-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 30rpx;
}

.verdict-stamp {
  font-size: var(--text-2xl);
  font-weight: bold;
  color: var(--color-surface);
  letter-spacing: 4rpx;
}

.verdict-id {
  font-size: var(--text-xs);
  color: rgba(255, 255, 255, 0.3);
  margin-top: 8rpx;
}

.source-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx var(--space-3);
  border-radius: var(--radius-lg);
  font-size: var(--text-sm);
  margin-bottom: var(--space-3);
  width: fit-content;
  margin-left: auto;
  margin-right: auto;
}

.source-ai {
  background: rgba(45, 91, 255, 0.15);
  color: var(--color-brand);
}

.source-local {
  background: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.6);
}

.verdict-card {
  background: var(--color-brand);
  border-radius: var(--radius-xl);
  padding: var(--space-5) var(--space-3);
  margin-bottom: var(--space-3);
  position: relative;
  overflow: hidden;
}

.verdict-card::before {
  content: '';
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.winner-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 1;
}

.winner-emoji {
  font-size: 80rpx;
  margin-bottom: var(--space-1);
}

.winner-name {
  font-size: var(--text-3xl-alt);
  font-weight: bold;
  color: var(--color-surface);
  margin-bottom: var(--space-2);
}

.winner-tags {
  display: flex;
  gap: 10rpx;
  margin-bottom: var(--space-2);
  flex-wrap: wrap;
  justify-content: center;
}

.winner-tag {
  background: rgba(255, 255, 255, 0.2);
  color: var(--color-surface);
  padding: 6rpx 18rpx;
  border-radius: var(--radius-md);
  font-size: var(--text-xs);
}

.winner-info {
  display: flex;
  gap: 20rpx;
  margin-bottom: var(--space-2);
  flex-wrap: wrap;
  justify-content: center;
}

.info-item {
  font-size: var(--text-sm);
  color: rgba(255, 255, 255, 0.85);
}

.winner-desc {
  font-size: var(--text-sm-alt);
  color: rgba(255, 255, 255, 0.8);
  text-align: center;
  line-height: 1.6;
}

.ai-comment {
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  margin-bottom: var(--space-3);
}

.comment-header {
  display: flex;
  align-items: center;
  gap: var(--space-1);
  margin-bottom: var(--space-2);
}

.comment-avatar {
  font-size: 40rpx;
}

.comment-name {
  font-size: var(--text-base);
  font-weight: bold;
  color: var(--color-brand);
}

.comment-text {
  font-size: var(--text-base);
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.8;
}

.reasons-section {
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  margin-bottom: var(--space-3);
}

.reasons-section .section-title {
  color: var(--color-surface);
}

.reason-item {
  display: flex;
  flex-direction: column;
  padding: var(--space-2) 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.reason-item:last-child {
  border-bottom: none;
}

.reason-name {
  font-size: var(--text-sm-alt);
  font-weight: bold;
  color: var(--color-brand);
  margin-bottom: 6rpx;
}

.reason-text {
  font-size: var(--text-sm);
  color: rgba(255, 255, 255, 0.6);
  line-height: 1.6;
}

.runner-up {
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  margin-bottom: 30rpx;
}

.runner-up .section-title {
  color: rgba(255, 255, 255, 0.5);
}

.runner-item {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  padding: var(--space-2) 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.04);
}

.runner-item:last-child {
  border-bottom: none;
}

.runner-emoji {
  font-size: var(--text-2xl);
}

.runner-info {
  display: flex;
  flex-direction: column;
}

.runner-name {
  font-size: var(--text-base);
  color: var(--color-surface);
  font-weight: bold;
}

.runner-desc {
  font-size: var(--text-xs);
  color: rgba(255, 255, 255, 0.4);
  margin-top: 4rpx;
}

.action-area {
  margin-bottom: 20rpx;
}

.share-btn {
  width: 100%;
  margin-bottom: var(--space-2);
  font-size: var(--text-lg);
  padding: var(--space-3);
  background: var(--color-brand) !important;
  box-shadow: 0 4rpx 16rpx rgba(45, 91, 255, 0.3) !important;
  transition: transform var(--duration-fast) var(--ease-out-quart), opacity var(--duration-fast) var(--ease-out-quart);
}

.share-btn:active {
  transform: scale(0.96) !important;
  opacity: 0.9 !important;
}

.secondary-actions {
  display: flex;
  gap: var(--space-2);
}

.veto-btn, .rejudge-btn {
  flex: 1;
  font-size: var(--text-sm-alt);
  padding: var(--space-2);
  transition: transform var(--duration-fast) var(--ease-out-quart), opacity var(--duration-fast) var(--ease-out-quart);
}

.veto-btn {
  background: var(--color-ink-secondary) !important;
  box-shadow: none !important;
}

.veto-btn:active {
  transform: scale(0.96) !important;
  opacity: 0.9 !important;
}

.rejudge-btn {
  background: var(--color-surface-dark-alt) !important;
  border: 1rpx solid rgba(255, 255, 255, 0.15) !important;
  box-shadow: none !important;
}

.rejudge-btn:active {
  transform: scale(0.96) !important;
  opacity: 0.9 !important;
}

.link-text {
  font-size: var(--text-base);
  color: var(--color-brand);
  font-weight: bold;
}

.save-btn {
  width: 100%;
  margin-bottom: var(--space-2);
  font-size: var(--text-base-alt);
  padding: 20rpx;
  background: var(--color-surface-dark-alt) !important;
  border: 1rpx solid rgba(255, 255, 255, 0.15) !important;
  box-shadow: none !important;
  transition: transform var(--duration-fast) var(--ease-out-quart), opacity var(--duration-fast) var(--ease-out-quart);
}

.save-btn:active {
  transform: scale(0.96) !important;
  opacity: 0.9 !important;
}

.poster-canvas {
  position: fixed;
  left: -9999rpx;
  width: 600px;
  height: 900px;
}

.chat-section {
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  margin-bottom: var(--space-3);
}

.chat-hint {
  font-size: var(--text-xs);
  color: rgba(255, 255, 255, 0.4);
  margin-bottom: 20rpx;
}

.chat-messages {
  margin-bottom: 20rpx;
}

.chat-msg {
  padding: var(--space-2) 20rpx;
  border-radius: var(--radius-md);
  margin-bottom: var(--space-1);
  max-width: 85%;
}

.msg-user {
  background: rgba(45, 91, 255, 0.2);
  margin-left: auto;
  border-bottom-right-radius: 4rpx;
}

.msg-ai {
  background: rgba(255, 255, 255, 0.08);
  margin-right: auto;
  border-bottom-left-radius: 4rpx;
}

.msg-loading .msg-text {
  color: rgba(255, 255, 255, 0.5);
  animation: textPulse 1.5s var(--ease-out-quart) infinite;
}

.msg-text {
  font-size: var(--text-sm-alt);
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.6;
}

.chat-input-row {
  display: flex;
  gap: var(--space-1);
  align-items: center;
}

.chat-input {
  flex: 1;
  height: 64rpx;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
  border-radius: var(--radius-sm);
  padding: 0 var(--space-2);
  font-size: var(--text-sm-alt);
  color: var(--color-surface);
  transition: border-color var(--duration-fast) var(--ease-out-quart);
}

.chat-input:focus {
  border-color: var(--color-brand);
}

.chat-send-btn {
  background: var(--color-brand);
  color: var(--color-surface);
  padding: var(--space-1) 28rpx;
  border-radius: var(--radius-sm);
  font-size: var(--text-sm-alt);
  font-weight: bold;
  white-space: nowrap;
  transition: transform var(--duration-fast) var(--ease-out-quart), opacity var(--duration-fast) var(--ease-out-quart);
}

.chat-send-btn:active {
  transform: scale(0.96);
  opacity: 0.9;
}

.restaurant-link {
  text-align: center;
  padding: var(--space-3);
  margin-top: 10rpx;
  transition: opacity var(--duration-fast) var(--ease-out-quart);
}

.restaurant-link:active {
  opacity: 0.7;
}

@media (prefers-reduced-motion: reduce) {
  .scale-wrap,
  .dot,
  .thinking-text,
  .msg-loading .msg-text {
    animation: none;
  }
  .thinking-bar {
    transition: none;
  }
}
